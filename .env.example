# Database (PostgreSQL — e.g. Supabase pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# Microsoft Graph / Azure AD (application credentials)
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# Optional Gemini key (also configurable via SystemConfig.gemini_api_key in Admin)
GEMINI_API_KEY=
