# Database (PostgreSQL — e.g. Supabase pooler)
# Must reach public.users_unified (EmployeeHub / Portal) and ticket_support.*
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# Session / Portal auth (client area uses EmployeeHub credentials)
# Prefer the same JWT_SECRET as EmployeeHub so soft-SSO (cookie abzToken) works.
JWT_SECRET=
# Optional dedicated secret for Ticket-Manager session cookies (falls back to JWT_SECRET)
TM_SESSION_SECRET=
# Cookie name used by EmployeeHub for JWT (default: abzToken)
PORTAL_JWT_COOKIE=abzToken
# Optional client-visible name for soft-SSO probe (defaults to abzToken)
# NEXT_PUBLIC_PORTAL_JWT_COOKIE=abzToken

# Public URL of this deploy (used to decide Secure cookies).
# On plain HTTP (e.g. http://host:9120) leave as http://… or set TM_COOKIE_SECURE=false.
# TM_PUBLIC_URL=http://vm.example.com:9120
# Force Secure cookie flag (true/false). Overrides URL detection when set.
# TM_COOKIE_SECURE=false

# Optional smoke-only (never commit real values)
# PORTAL_TEST_EMAIL=
# PORTAL_TEST_PASSWORD=

# Microsoft Graph / Azure AD (application credentials)
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# Optional Gemini key (also configurable via SystemConfig.gemini_api_key in Admin)
GEMINI_API_KEY=
